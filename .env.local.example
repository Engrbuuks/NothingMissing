# Copy to .env.local. Never commit it.

# --- required ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_ROOT_DOMAIN=nothingmissing.ng

# The anon key belongs in a browser: it identifies the project, not a person,
# and every table is protected by row-level security.

# --- required only for the Paystack webhook ---------------------------------
# Bypasses row-level security entirely. It is used in exactly one file —
# src/app/api/webhooks/paystack/route.ts — where there is no user session
# because the caller is Paystack. Never import it anywhere else.
SUPABASE_SERVICE_ROLE_KEY=

# --- email ------------------------------------------------------------------
# Without this, notifications queue and are visible in the app but are not
# delivered. A missing key degrades to "nothing sent" rather than a crash.
RESEND_API_KEY=
NOTIFY_FROM=Nothing Missing <no-reply@nothingmissing.ng>

# --- SMS and WhatsApp --------------------------------------------------------
# Termii, because international providers route poorly to MTN and Glo and
# delivery rate matters more than API elegance for "your delivery is overdue".
TERMII_API_KEY=
TERMII_SENDER_ID=NothingMissing

# --- payments ----------------------------------------------------------------
# Billing shows usage and cost without these. With them, the Pay button works.
# Set the webhook in the Paystack dashboard to:
#   https://nothingmissing.ng/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- file storage ------------------------------------------------------------
# Cloudflare R2. Egress is free, which matters because logos are fetched on
# every page load. Leave these unset and Supabase Storage is used instead, with
# no code change. See backend/STORAGE.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nothing-missing
# Optional: an R2 custom domain scoped to the branding/ prefix. Without it,
# logos fall back to Supabase Storage while everything else stays on R2.
NEXT_PUBLIC_R2_PUBLIC_BASE=

# --- error reporting ---------------------------------------------------------
# Without this, errors go to the server log as structured JSON, searchable in
# Vercel. Set it to forward them somewhere durable.
SENTRY_DSN=
