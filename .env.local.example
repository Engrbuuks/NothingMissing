# Copy to .env.local. Never commit .env.local.
#
# The anon key is designed to sit in a browser: it identifies the project, not
# a person, and every table is protected by row-level security. It is not a
# secret in the usual sense.
#
# The service role key IS a secret. It bypasses RLS entirely — anything holding
# it can read and write every company's data. It must never appear in client
# code, in this file, or in a repository.
NEXT_PUBLIC_SUPABASE_URL=https://cukuzoawdlewxcnrcxny.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-key-here

# The domain tenants live under. Change this and everything follows.
NEXT_PUBLIC_ROOT_DOMAIN=nothingmissing.ng
