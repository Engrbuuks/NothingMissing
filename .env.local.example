# Copy to .env.local. Never commit it.

# --- required ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_ROOT_DOMAIN=nothingmissing.ng

# The anon key belongs in a browser: it identifies the project, not a person,
# and every table is protected by row-level security. The SERVICE ROLE key is
# a secret — it bypasses RLS entirely and must never appear here or in a repo.

# --- optional: email ---------------------------------------------------------
# Without this, notifications are queued and shown in the app but not sent.
# That is a deliberate degradation rather than a crash.
RESEND_API_KEY=
NOTIFY_FROM=Nothing Missing <no-reply@nothingmissing.ng>

# --- optional: error reporting ----------------------------------------------
# Without this, errors go to the server log as structured JSON, which is
# searchable in Vercel. Set it to forward them somewhere durable.
SENTRY_DSN=

# --- optional: payments ------------------------------------------------------
# Billing shows usage and cost without these; nothing can be charged until a
# live Paystack business account is connected.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
